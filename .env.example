# LLM Configuration (works with any OpenAI-compatible API)
# Supports: OmniRoute, OpenAI, Anthropic, Ollama, vLLM, LiteLLM, etc.

# Base URL of your LLM API
LLM_BASE_URL=http://localhost:3000

# API key (if required)
LLM_API_KEY=your-api-key-here

# Content model
LLM_MODEL=claude-3.5-sonnet

# Fallback model
LLM_FALLBACK_MODEL=gpt-4o

# Image model (optional)
LLM_IMAGE_MODEL=dall-e-3
